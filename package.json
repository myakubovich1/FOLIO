{
  "name": "folio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.17"
  },
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "npm run typecheck && next build --webpack",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc -p tsconfig.check.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "review": "bash scripts/review.sh",
    "builder": "bash scripts/builder.sh",
    "lint": "eslint .",
    "format": "prettier --write src server tests app scripts/*.ts *.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "providers:check": "tsx scripts/check-providers.ts",
    "nessie:seed": "tsx scripts/seed-nessie.ts",
    "db:copy-local": "tsx scripts/copy-local.ts",
    "db:benchmark": "tsx scripts/benchmark.ts",
    "export:demo": "tsx scripts/export-demo.ts",
    "eval:ai": "tsx scripts/evaluate.ts",
    "brand:generate": "node scripts/brand.mjs",
    "db:seed": "tsx scripts/seed.ts",
    "nessie:setup": "tsx scripts/setup-nessie.ts",
    "providers:smoke": "tsx scripts/provider-smoke.ts",
    "db:transfer": "tsx scripts/transfer.ts"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/inter-tight": "^5.3.0",
    "@google/genai": "^2.30.0",
    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.8",
    "express": "^5.1.0",
    "express-openid-connect": "^3.4.0",
    "fontkit": "^2.0.4",
    "multer": "^2.4.0",
    "next": "^16.4.2",
    "on-headers": "^1.1.0",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.56.0",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.0.0",
    "@types/on-headers": "^1.0.4",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.1.0"
  }
}
