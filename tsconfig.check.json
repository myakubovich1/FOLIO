{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "server/**/*.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "tests/**/*.ts",
    "scripts/*.ts",
    "next.config.ts",
    "playwright.config.ts",
    "pages/**/*.ts"
  ],
  "exclude": ["node_modules", ".next"]
}
